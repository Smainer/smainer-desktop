{
  "$schema": "../gen/schemas/desktop-schema.json", 
  "identifier": "default",
  "description": "Default capability for the main window",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file", 
    "fs:allow-create-dir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "shell:allow-execute",
    "os:allow-locale",
    "os:allow-platform",
    "os:allow-version", 
    "process:allow-exit",
    "process:allow-restart",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
