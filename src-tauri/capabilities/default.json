{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "path:default",
    "event:default",
    "window:default",
    "app:default",
    "resources:default",
    "menu:default",
    "tray:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-create-dir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "shell:allow-execute",
    "os:allow-locale",
    "os:allow-platform",
    "os:allow-version",
    "process:allow-exit",
    "process:allow-restart",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
